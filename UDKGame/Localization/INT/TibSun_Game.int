;=====================================
;	Game
;=====================================
[TS_Game]
Description="Destroy the enemy base while protecting your own."
GameName="Firestorm Mode"
EndOfMatchRulesTemplateStr_Scoring=First team to destroy the other wins
EndOfMatchRulesTemplateStr_Time=Team with most points in `t mins. wins
PreviewGameImage=Texture2D'TS_HUD_Canvas.Scoreboard.T_HUD_VOTE_Tibsun'

[TD_Game_Conquest]
Description="Destroy the enemy base while protecting your own."
GameName="Tiberium Dawn Mode"
EndOfMatchRulesTemplateStr_Scoring=First team to destroy the other wins
EndOfMatchRulesTemplateStr_Time=Team with most points in `t mins. wins
PreviewGameImage=Texture2D'TS_HUD_Canvas.Scoreboard.T_HUD_VOTE_Tibdawn'

