[UTDeathmatch UTUIDataProvider_GameModeInfo]
FriendlyName=Deathmatch
Description=Free-for-all deathmatch action.

[UTTeamGame UTUIDataProvider_GameModeInfo]
FriendlyName=Team Deathmatch
Description=Team-based deathmatch action.

[UTVehicleCTFGame_Content UTUIDataProvider_GameModeInfo]
FriendlyName=Vehicle CTF
Description=Team-based capture the flag with vehicles.  Invade the opposing team's base, grab their flag, and bring it back to your own to obtain glory.

;///////////////
; Instant Action Options
;///////////////

[BotSkill_Common UTUIDataProvider_MenuOption]
FriendlyName=AI 难度
Description=Set the skill level of AI-controlled bots.

[NumBots_Common UTUIDataProvider_MenuOption]
FriendlyName=Number of Bots
Description=The number of bots in the game.

[GoalScore_Common UTUIDataProvider_MenuOption]
FriendlyName=Goal Score
Description=The score limit for a single game round. 0 means no limit.

[TimeLimit_Common UTUIDataProvider_MenuOption]
FriendlyName=Time Limit
Description=The time limit for a single game round. 0 means a never ending round.

;///////////////
; Deathmatch Options
;///////////////

[BotSkill_DM UTUIDataProvider_MenuOption]
FriendlyName=AI 难度
Description=Set the skill level of AI-controlled bots.

[NumBots_DM UTUIDataProvider_MenuOption]
FriendlyName=Number of Opponents
Description=The number of opponents to always have in the game.  Bots will be added if there are not enough human players.

[VsBots_DM UTUIDataProvider_MenuOption]
FriendlyName=Versus Bots Ratio
Description=Set the ratio of bots per human player to spawn (using this option overrides the Number of Opponents setting).

[GoalScore_DM UTUIDataProvider_MenuOption]
FriendlyName=Goal Score
Description=Set the score limit for a single game round. 0 means no limit.

[TimeLimit_DM UTUIDataProvider_MenuOption]
FriendlyName=Time Limit
Description=Set the time limit for a single round. 0 means no time limit.

[ForceRespawn_DM UTUIDataProvider_MenuOption]
FriendlyName=Force Respawn
Description=Toggle whether or not to force players to respawn.
;///////////////
; Audio Options
;///////////////

[HardwareOpenAL UTUIDataProvider_MenuOption]
FriendlyName=Hardware OpenAL
Description=Toggle whether or not to use hardware OpenAL (if available).  Changing this option will require a restart of the game before the change will take affect.

[SFXVolume UTUIDataProvider_MenuOption]
FriendlyName=SFX Volume
Description=Control the volume of sound effects in the game.

[MusicVolume UTUIDataProvider_MenuOption]
FriendlyName=Music Volume
Description=Control the volume of music in the game.

[VoiceVolume UTUIDataProvider_MenuOption]
FriendlyName=Voice Volume
Description=Control the volume of voice in the game.

[AmbianceVolume UTUIDataProvider_MenuOption]
FriendlyName=Ambiance Volume
Description=Control the volume of ambient sounds in the game.

[AnnouncerVolume UTUIDataProvider_MenuOption]
FriendlyName=Announcer Volume
Description=Control the volume of the announcer in the game.

[AnnounceSetting UTUIDataProvider_MenuOption]
FriendlyName=Announcement Type
Description=Control the type of announcements to play in the game.

;///////////////
; Server Options
;///////////////
[ServerType UTUIDataProvider_MenuOption]
FriendlyName=Server Type
Description=The type of server to start the game with.

[ServerType360 UTUIDataProvider_MenuOption]
FriendlyName=Server Type
Description=The type of server to start the game with.

[MaxPlayers_PC UTUIDataProvider_MenuOption]
FriendlyName=Max Players
Description=Maximum number of players to allow on the server.

[MaxPlayers_Console UTUIDataProvider_MenuOption]
FriendlyName=Max Players
Description=Maximum number of players to allow on the server.

[MinNumPlayers_PC UTUIDataProvider_MenuOption]
FriendlyName=Min Players
Description=Minimum number of players needed before the match starts.

[MinNumPlayers_Console UTUIDataProvider_MenuOption]
FriendlyName=Min Players
Description=Minimum number of players needed before the match starts.

[PrivateSlots UTUIDataProvider_MenuOption]
FriendlyName=Private Slots
Description=Number of private slots to reserve on the server for invited players.

[AllowKeyboard UTUIDataProvider_MenuOption]
FriendlyName=Keyboard & Mouse
Description=Enable to allow players to use a keyboard and mouse in the game.

[ServerDescription UTUIDataProvider_MenuOption]
FriendlyName=Description
Description=Short description to display along with the hostname for this server in the server browser.

[ServerMOTD UTUIDataProvider_MenuOption]
FriendlyName=MOTD
Description=Message of the Day to display when a player joins the server.

[ServerPassword UTUIDataProvider_MenuOption]
FriendlyName=Server Password
Description=Password needed to connect to this server.  Leave blank for an unlocked server.

;///////////////
; Client Options
;///////////////

[MatchType UTUIDataProvider_MenuOption]
FriendlyName=Match Type
Description=The type of match to search for.

[MatchType360 UTUIDataProvider_MenuOption]
FriendlyName=Match Type
Description=The type of match to search for.

[GameMode_Client UTUIDataProvider_MenuOption]
FriendlyName=Game Mode
Description=The type of game mode to search for.

[PureServer_Client UTUIDataProvider_MenuOption]
FriendlyName=Pure Server
Description=Toggle whether or not to show only pure servers.

[LockedServer_Client UTUIDataProvider_MenuOption]
FriendlyName=Locked Server
Description=Toggle whether or not to show locked servers that require passwords to join.

[FullServer_Client UTUIDataProvider_MenuOption]
FriendlyName=Show Full Servers
Description=Enable to show full servers.

[EmptyServer_Client UTUIDataProvider_MenuOption]
FriendlyName=Show Empty Servers
Description=Enable to show empty servers.

[AllowKeyboard_Client UTUIDataProvider_MenuOption]
FriendlyName=Keyboard & Mouse
Description=Controls whether servers which allow players to use a keyboard and mouse are included in the list.
