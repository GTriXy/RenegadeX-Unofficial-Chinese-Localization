VehicleMessages[6]="Can not bind vehicle, it is already bound to `OwnerName`."

VehicleMessages[7]="`VehicleClass` driver seat Locked."
VehicleMessages[8]="`VehicleClass` driver seat Unlocked."

VehicleMessages[9]="Driver seat is locked by `OwnerName`."
VehicleMessages[10]="You can't enter the Vehicle. Buyer '`OwnerName`' has exclusive access for `IntegerValue` more seconds."
VehicleMessages[11]="You can't enter the Vehicle. `OwnerTeam` has exclusive access for `IntegerValue` more seconds."

VehicleMessages[12]="`OwnerName`'s `VehicleClass` has been stolen by the enemy!"
